generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RoutingRecord {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())

  weight            Float
  value             Float
  destinationCountry String?
  recipientName     String?
  batchId           String?   

  department        String    
  requiresInsurance Boolean   @default(false)
  reason            String    
  appliedRuleLabel  String    
  flags             String[]  

  source            String    
  processingMs      Int?      

  @@index([createdAt])
  @@index([department])
  @@index([batchId])
}

model BatchJob {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  filename    String
  format      String    
  totalCount  Int
  successCount Int
  errorCount  Int
  status      String    

  @@index([createdAt])
}